# Where the storefront reads products and site content from.
#   static → bundled seed data in src/data/seed (default; used by GitHub Pages)
#   api    → the Hono API (Cloudflare Pages forwards /api/* to the Worker)
# Set VITE_DATA_SOURCE=api in the Cloudflare Pages build settings, and in
# .env.local for local development with `npm run dev:api`.
VITE_DATA_SOURCE=static
# Leave empty to call the API on the same origin (recommended).
VITE_API_BASE_URL=
