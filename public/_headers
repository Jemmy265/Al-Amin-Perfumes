# Applied by Cloudflare Workers Static Assets — no Worker invocation.
# HTML keeps the platform default (public, max-age=0, must-revalidate + ETag),
# so every deploy is picked up immediately while unchanged pages cost a 304.

# Vite output: file names contain a content hash → safe to cache forever.
/static/*
  Cache-Control: public, max-age=31536000, immutable

# Original photos, logos, icons (not fingerprinted).
/assets/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'

/admin/*
  X-Frame-Options: DENY
  X-Robots-Tag: noindex, nofollow
