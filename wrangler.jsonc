// Al-Amin Perfumes — ONE Cloudflare Worker serving the whole application:
//   /            storefront          ─┐  Workers Static Assets: served directly,
//   /admin/      admin dashboard      │  no Worker invocation, free & unlimited
//   /assets/*    original photos     ─┘
//   /api/*       Hono API (D1)       ─┐  Worker code (run_worker_first)
//   /images/*    uploaded photos (R2) ─┘
// Deploy: npm run deploy   ·   Secrets: npx wrangler secret put ADMIN_PASSWORD_HASH
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "alamin-perfumes",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    "run_worker_first": ["/api/*", "/images/*"]
  },
  "observability": { "enabled": true, "head_sampling_rate": 0.1 },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "alamin-db",
      "database_id": "f5d59e8d-a1e5-4077-bf4f-357d5063749f",
      "migrations_dir": "worker/migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "IMAGES", "bucket_name": "alamin-images" }
  ],
  "vars": {
    "ADMIN_USERNAME": "admin"
  }
}
