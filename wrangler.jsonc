// Cloudflare Pages project: storefront (/) + admin dashboard (/admin/).
// Build command: npm run build   ·   Output: dist   ·   Build env: VITE_DATA_SOURCE=api
// /api/* and /images/* are forwarded to the alamin-api Worker (see functions/).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "alamin-store",
  "pages_build_output_dir": "dist",
  "compatibility_date": "2026-11-01",
  "services": [
    { "binding": "API", "service": "alamin-api" }
  ]
}
