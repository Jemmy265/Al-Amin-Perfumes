{
  "name": "al-amin-perfumes-storefront",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b && tsc -p worker/tsconfig.json && tsc -p functions/tsconfig.json",
    "test": "vitest run",
    "dev:api": "cd worker && wrangler dev --port 8787",
    "db:migrate:local": "cd worker && wrangler d1 migrations apply alamin-db --local",
    "db:migrate:remote": "cd worker && wrangler d1 migrations apply alamin-db --remote",
    "db:reset:local": "rm -rf worker/.wrangler/state/v3/d1 && npm run db:migrate:local",
    "db:seed-sql": "tsx scripts/gen-seed-sql.ts",
    "images:seed:local": "node scripts/upload-seed-images.mjs --local",
    "images:seed:remote": "node scripts/upload-seed-images.mjs --remote",
    "admin:hash-password": "node scripts/hash-password.mjs",
    "deploy:api": "cd worker && wrangler deploy"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "gsap": "^3.15.1",
    "hono": "^4.13.21",
    "lenis": "^1.3.28",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261124.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "wrangler": "^4.168.0"
  }
}
