// Al-Amin Perfumes API (Hono on Cloudflare Workers).
// Before the first deploy, create the resources and paste their ids below:
//   npx wrangler d1 create alamin-db
//   npx wrangler r2 bucket create alamin-images
// Secrets (never committed):
//   node scripts/hash-password.mjs | npx wrangler secret put ADMIN_PASSWORD_HASH -c worker/wrangler.jsonc
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "alamin-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Reached only through the Pages site (service binding), never directly.
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "alamin-db",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "IMAGES", "bucket_name": "alamin-images" }
  ],
  "vars": {
    "ADMIN_USERNAME": "admin"
  }
}
